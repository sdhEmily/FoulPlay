<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.private.skip-library-validation</key>
    <true/>
    <!-- UIActivityViewController scales app icons in-process through CoreImage,
         which needs a Metal/IOAccel backend. Without these the sandbox denies
         AGXDeviceUserClient and IOSurfaceRootUserClient, CoreImage ends up with
         a null GL context and the share sheet segfaults.
         Trimmed from Sileo's list: no framebuffer or surface-blit classes,
         which are for display capture rather than app rendering. -->
    <key>com.apple.security.iokit-user-client-class</key>
    <array>
        <string>AGXDeviceUserClient</string>
        <string>AGXCommandQueue</string>
        <string>AGXSharedUserClient</string>
        <string>AGXGLContext</string>
        <string>IOAccelDevice</string>
        <string>IOAccelDevice2</string>
        <string>IOAccelContext</string>
        <string>IOAccelContext2</string>
        <string>IOAccelSharedUserClient</string>
        <string>IOAccelSharedUserClient2</string>
        <string>IOAccelSubmitter2</string>
        <string>IOSurfaceRootUserClient</string>
    </array>
</dict>
</plist>
